{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopease.example/schemas/knowledge-document.schema.json",
  "title": "ShopEase knowledge document metadata",
  "description": "Machine-readable metadata envelope. The example domain is fictional and must not be treated as a real source.",
  "type": "object",
  "required": ["documentId", "title", "module", "submodule", "documentType", "intent", "customerSegment", "applicableRegion", "applicableChannel", "version", "lastUpdated", "effectiveDate", "status", "source", "relatedDocuments", "content"],
  "properties": {
    "documentId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "module": { "type": "string", "minLength": 1 },
    "submodule": { "type": "string", "minLength": 1 },
    "documentType": { "type": "string", "minLength": 1 },
    "intent": { "type": "array", "items": { "type": "string" } },
    "customerSegment": { "type": "string" },
    "applicableRegion": { "type": "string" },
    "applicableChannel": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "lastUpdated": { "type": "string", "format": "date" },
    "effectiveDate": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "needs-owner-approval", "approved", "retired", "fictional-demo"] },
    "source": { "type": "string", "minLength": 1 },
    "relatedDocuments": { "type": "array", "items": { "type": "string" } },
    "content": { "type": "object" }
  },
  "additionalProperties": false
}
